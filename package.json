{
  "name": "bored",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A single-file arcade hub built from split Vite source files",
  "scripts": {
    "dev": "vite",
    "dev:infisical": "infisical run --env=dev -- vite",
    "build": "vite build && node scripts/publish.mjs",
    "preview": "vite preview",
    "games:add": "node scripts/games.mjs add",
    "games:register": "node scripts/games.mjs register",
    "feedback:setup": "node scripts/setup-feedback.mjs",
    "test": "node --test tests/bored.test.cjs tests/discovery.test.cjs tests/player-state.test.cjs tests/backend-safety.test.cjs",
    "test:visual": "node --test tests/visual.test.cjs",
    "previews:capture": "node scripts/capture-previews.mjs",
    "previews:optimize": "python3 scripts/optimize-previews.py"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
