{
  "name": "bored",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A single-file arcade hub built from split Vite source files",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/sync-games.mjs",
    "dev:infisical": "infisical run --env=dev -- vite",
    "build": "vite build && node scripts/publish.mjs",
    "prebuild": "node scripts/sync-games.mjs",
    "preview": "vite preview",
    "games:sync": "node scripts/sync-games.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
