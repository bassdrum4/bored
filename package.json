{
  "name": "bored",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An arcade hub served straight from src/ by GitHub Pages",
  "scripts": {
    "dev": "vite",
    "dev:infisical": "infisical run --env=dev -- vite",
    "games:add": "node scripts/games.mjs add",
    "games:register": "node scripts/games.mjs register",
    "feedback:setup": "node scripts/setup-feedback.mjs",
    "test": "node --test --test-concurrency=1 tests/bored.test.cjs tests/discovery.test.cjs tests/player-state.test.cjs tests/backend-safety.test.cjs",
    "test:visual": "node --test tests/visual.test.cjs",
    "previews:capture": "node scripts/capture-previews.mjs",
    "previews:optimize": "python3 scripts/optimize-previews.py"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0",
    "vite": "^8.3.4"
  }
}
